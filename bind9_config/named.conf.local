// Minhas zonas para AngelCorp
zone "angelcorp.com.br" {
    type master;
    file "/etc/bind/db.angelcorp.com.br";
    allow-transfer { 10.0.0.2; }; //slave
    also-notify { 10.0.0.2; };
};

zone "0.0.10.in-addr.arpa" {
    type master;
    file "/etc/bind/db.10.0.0";
    allow-transfer { 10.0.0.2; }; //slave
    also-notify { 10.0.0.2; };
};